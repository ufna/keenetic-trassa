#!/bin/sh
# trassa: start, supervise and stop the daemon and the web page.
# The log and service files live in /tmp (RAM) so the flash does not wear out.
# At boot Entware's rc.unslung runs it as "S99trassa start" in a separate process (its "."
# branch matches only bare names, and find gives full paths); the supervisors it starts in the
# background outlive rc.unslung.

TRASSA_BIN=/opt/sbin/trassa
TRASSA_CONF=/opt/etc/trassa
TRASSA_PID=/tmp/trassa.pid
TRASSA_WEB_PID=/tmp/trassa-web.pid
TRASSA_SUP=/tmp/trassa.supervisor.pids
TRASSA_SUP_DAEMON=/tmp/trassa.supervisor.pid
TRASSA_OFF=$TRASSA_CONF/disabled
TRASSA_STOP=/tmp/trassa.stop
TRASSA_LOG=/tmp/trassa.log
TRASSA_LOG_MAX=1048576
TRASSA_LOG_KEEP=262144

# Is this process ours: $1 is the PID, $2 the subcommand (run for the daemon, web for the page).
# The PID may have been reused by an unrelated process.
trassa_ours() {
	[ -n "$1" ] && [ -r "/proc/$1/cmdline" ] && tr '\0' ' ' <"/proc/$1/cmdline" | grep -q "^$TRASSA_BIN $2 "
}

# PID of the daemon, if the daemon is alive.
trassa_pid() {
	[ -f $TRASSA_PID ] || return 1
	trassa_p=$(cat $TRASSA_PID 2>/dev/null)
	trassa_ours "$trassa_p" run && echo "$trassa_p"
}

# All processes with subcommand $1 (run or web), including ones missing from the pid file.
trassa_all() {
	for trassa_p in $(pidof trassa 2>/dev/null); do
		trassa_ours "$trassa_p" "$1" && echo "$trassa_p"
	done
}

# Is the daemon supervisor alive. While trassa is turned off it waits with no daemon running.
trassa_sup_alive() {
	trassa_p=$(cat $TRASSA_SUP_DAEMON 2>/dev/null)
	[ -n "$trassa_p" ] && [ -r "/proc/$trassa_p/cmdline" ] && tr '\0' ' ' <"/proc/$trassa_p/cmdline" | grep -q "S99trassa"
}

# Supervisor: if the daemon exits on its own, remove its rules and start it again.
# The supervisor owns the pid file: it writes it right after start and removes it after exit.
# While trassa is turned off (the web page or "trassa disable" writes $TRASSA_OFF) it does not
# start the daemon and checks every 2 seconds whether trassa has been turned on.
trassa_supervise() {
	trap "" HUP PIPE
	PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
	export PATH
	trassa_pause=5
	trassa_off=0
	while [ ! -f $TRASSA_STOP ]; do
		if [ -f $TRASSA_OFF ]; then
			[ $trassa_off = 0 ] && echo "$(date '+%Y/%m/%d %H:%M:%S') trassa is turned off: the daemon stays stopped until it is turned on" >>$TRASSA_LOG
			trassa_off=1
			sleep 2
			continue
		fi
		if [ $trassa_off = 1 ]; then
			echo "$(date '+%Y/%m/%d %H:%M:%S') trassa turned on: starting the daemon" >>$TRASSA_LOG
			trassa_pause=5
		fi
		trassa_off=0
		trassa_args=""
		[ -r $TRASSA_CONF/args ] && trassa_args=$(cat $TRASSA_CONF/args)
		trassa_t0=$(date +%s)
		set -f # arguments are split on spaces but not expanded as file globs
		$TRASSA_BIN run -rules $TRASSA_CONF/rules.conf $trassa_args >>$TRASSA_LOG 2>&1 &
		set +f
		echo $! >$TRASSA_PID
		wait $!
		trassa_code=$?
		rm -f $TRASSA_PID
		$TRASSA_BIN cleanup >>$TRASSA_LOG 2>&1
		[ -f $TRASSA_STOP ] && break
		# Turned off: the daemon stopped on request, this is not a crash.
		[ -f $TRASSA_OFF ] && continue
		# The daemon ran for over a minute, so this is not a crash loop: reset the pause to the initial value.
		[ $(($(date +%s) - trassa_t0)) -ge 60 ] && trassa_pause=5
		echo "$(date '+%Y/%m/%d %H:%M:%S') daemon exited with code $trassa_code, restart in $trassa_pause s" >>$TRASSA_LOG
		sleep $trassa_pause
		[ $trassa_pause -lt 60 ] && trassa_pause=$((trassa_pause * 2))
	done
}

# Watchdog: if the daemon is alive but not responding, kill it. It also keeps the log from growing without limit.
trassa_watch() {
	trap "" HUP PIPE
	trassa_fails=0
	while [ ! -f $TRASSA_STOP ]; do
		sleep 5
		if $TRASSA_BIN status >/dev/null 2>&1; then
			trassa_fails=0
		else
			trassa_fails=$((trassa_fails + 1))
		fi
		if [ $trassa_fails -ge 2 ]; then
			trassa_p=$(trassa_pid) && {
				echo "$(date '+%Y/%m/%d %H:%M:%S') daemon not responding, killing it" >>$TRASSA_LOG
				kill -9 "$trassa_p" 2>/dev/null
			}
			trassa_fails=0
		fi
		if [ "$(wc -c <$TRASSA_LOG 2>/dev/null || echo 0)" -gt $TRASSA_LOG_MAX ]; then
			# Writers open the log in append mode, so it can be truncated in place.
			tail -c $TRASSA_LOG_KEEP $TRASSA_LOG >$TRASSA_LOG.keep 2>/dev/null &&
				cat $TRASSA_LOG.keep >$TRASSA_LOG
			rm -f $TRASSA_LOG.keep
			echo "$(date '+%Y/%m/%d %H:%M:%S') log truncated" >>$TRASSA_LOG
		fi
	done
}

# Web page supervisor: if the page exits, start it again. The page does not touch the network,
# so there is nothing to clean up after it.
trassa_supervise_web() {
	trap "" HUP PIPE
	PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
	export PATH
	trassa_pause=5
	while [ ! -f $TRASSA_STOP ]; do
		trassa_args=$(cat $TRASSA_CONF/web.args 2>/dev/null)
		trassa_t0=$(date +%s)
		set -f
		$TRASSA_BIN web -dir $TRASSA_CONF $trassa_args >>$TRASSA_LOG 2>&1 &
		set +f
		echo $! >$TRASSA_WEB_PID
		wait $!
		trassa_code=$?
		rm -f $TRASSA_WEB_PID
		[ -f $TRASSA_STOP ] && break
		[ $(($(date +%s) - trassa_t0)) -ge 60 ] && trassa_pause=5
		echo "$(date '+%Y/%m/%d %H:%M:%S') web page exited with code $trassa_code, restart in $trassa_pause s" >>$TRASSA_LOG
		sleep $trassa_pause
		[ $trassa_pause -lt 60 ] && trassa_pause=$((trassa_pause * 2))
	done
}

trassa_start() {
	if [ ! -x $TRASSA_BIN ]; then
		echo "$TRASSA_BIN not found"
		return 1
	fi
	trassa_daemon_up=0
	if $TRASSA_BIN status >/dev/null 2>&1 || [ -n "$(trassa_all run)" ] || trassa_sup_alive; then
		trassa_daemon_up=1
	fi
	trassa_web_up=0
	[ -n "$(trassa_all web)" ] && trassa_web_up=1
	# Nothing is running: start the supervisor list afresh, since the PIDs of earlier processes
	# may have been reused by unrelated processes.
	if [ $trassa_daemon_up = 0 ] && [ $trassa_web_up = 0 ]; then
		: >$TRASSA_SUP
	fi
	rm -f $TRASSA_STOP
	trassa_rc=0
	# The daemon and the page start independently: the page is needed even when the rules
	# have errors, so that they can be fixed.
	if [ $trassa_daemon_up = 1 ]; then
		if [ -f $TRASSA_OFF ]; then
			echo "trassa is turned off; it starts once turned on (the web page or: trassa enable)"
		else
			echo "trassa daemon is already running"
		fi
	elif [ ! -f $TRASSA_OFF ] && ! $TRASSA_BIN check $TRASSA_CONF/rules.conf >/dev/null; then
		echo "the rules have errors, trassa daemon not started: $TRASSA_BIN check $TRASSA_CONF/rules.conf"
		trassa_rc=1
	else
		rm -f $TRASSA_PID
		# The supervisor and watchdog loops are detached from the session that started them. Otherwise
		# the shell, when reporting a daemon killed by a signal, writes to the closed session and dies
		# itself, leaving the daemon unsupervised.
		trassa_supervise >>$TRASSA_LOG 2>&1 </dev/null &
		echo $! >>$TRASSA_SUP
		echo $! >$TRASSA_SUP_DAEMON
		trassa_watch >>$TRASSA_LOG 2>&1 </dev/null &
		echo $! >>$TRASSA_SUP
		if [ -f $TRASSA_OFF ]; then
			echo "trassa is turned off; it starts once turned on (the web page or: trassa enable)"
		else
			echo "trassa daemon started"
		fi
	fi
	# The page is started only if its address is configured.
	if [ -f $TRASSA_CONF/web.args ]; then
		if [ $trassa_web_up = 1 ]; then
			echo "web page is already running"
		else
			trassa_supervise_web >>$TRASSA_LOG 2>&1 </dev/null &
			echo $! >>$TRASSA_SUP
			echo "web page started ($(cat $TRASSA_CONF/web.args))"
		fi
	fi
	return $trassa_rc
}

trassa_stop() {
	touch $TRASSA_STOP
	if [ -f $TRASSA_SUP ]; then
		for trassa_p in $(cat $TRASSA_SUP); do
			kill "$trassa_p" 2>/dev/null
		done
	fi
	# The daemon stops on a signal; wait until all its processes are gone.
	for trassa_p in $(trassa_all run) $(trassa_all web); do
		kill "$trassa_p" 2>/dev/null
	done
	trassa_i=0
	while [ -n "$(trassa_all run)$(trassa_all web)" ] && [ $trassa_i -lt 10 ]; do
		sleep 1
		trassa_i=$((trassa_i + 1))
	done
	for trassa_p in $(trassa_all run) $(trassa_all web); do
		kill -9 "$trassa_p" 2>/dev/null
	done
	$TRASSA_BIN cleanup >/dev/null 2>&1
	rm -f $TRASSA_SUP $TRASSA_SUP_DAEMON $TRASSA_PID $TRASSA_WEB_PID
	echo "trassa stopped"
}

case "$1" in
start)
	trassa_start
	;;
stop)
	trassa_stop
	;;
restart)
	trassa_stop
	trassa_start
	;;
status)
	[ -f $TRASSA_OFF ] && echo "trassa is turned off (the web page or: trassa enable)"
	$TRASSA_BIN status
	trassa_w=$(trassa_all web | head -1)
	if [ -n "$trassa_w" ]; then
		echo "web page: running ($(cat $TRASSA_CONF/web.args 2>/dev/null))"
	else
		echo "web page: not running"
	fi
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac
