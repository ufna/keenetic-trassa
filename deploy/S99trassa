#!/bin/sh
# trassa: запуск, присмотр и остановка демона и веб-страницы.
# Журнал и служебные файлы лежат в /tmp (оперативная память), чтобы не изнашивать флеш.

TRASSA_BIN=/opt/sbin/trassa
TRASSA_CONF=/opt/etc/trassa
TRASSA_PID=/tmp/trassa.pid
TRASSA_WEB_PID=/tmp/trassa-web.pid
TRASSA_SUP=/tmp/trassa.supervisor.pids
TRASSA_STOP=/tmp/trassa.stop
TRASSA_LOG=/tmp/trassa.log
TRASSA_LOG_MAX=1048576
TRASSA_LOG_KEEP=262144

# Наш ли это процесс: $1 — номер, $2 — подкоманда (run — демон, web — страница).
# Номер процесса мог достаться постороннему процессу.
trassa_ours() {
	[ -n "$1" ] && [ -r "/proc/$1/cmdline" ] && tr '\0' ' ' <"/proc/$1/cmdline" | grep -q "^$TRASSA_BIN $2 "
}

# Номер процесса демона, если демон жив.
trassa_pid() {
	[ -f $TRASSA_PID ] || return 1
	trassa_p=$(cat $TRASSA_PID 2>/dev/null)
	trassa_ours "$trassa_p" run && echo "$trassa_p"
}

# Все процессы с подкомандой $1 (run или web), включая оставшиеся без записи в файле.
trassa_all() {
	for trassa_p in $(pidof trassa 2>/dev/null); do
		trassa_ours "$trassa_p" "$1" && echo "$trassa_p"
	done
}

# Присмотр: если демон завершился сам, снять его правила и запустить снова.
# Файлом с номером процесса владеет присмотр: записывает сразу после запуска, удаляет после завершения.
trassa_supervise() {
	trap "" HUP PIPE
	PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
	export PATH
	trassa_pause=5
	while [ ! -f $TRASSA_STOP ]; do
		trassa_args=""
		[ -r $TRASSA_CONF/args ] && trassa_args=$(cat $TRASSA_CONF/args)
		trassa_t0=$(date +%s)
		set -f # аргументы делятся по пробелам, но не раскрываются как маски файлов
		$TRASSA_BIN run -rules $TRASSA_CONF/rules.conf $trassa_args >>$TRASSA_LOG 2>&1 &
		set +f
		echo $! >$TRASSA_PID
		wait $!
		trassa_code=$?
		rm -f $TRASSA_PID
		$TRASSA_BIN cleanup >>$TRASSA_LOG 2>&1
		[ -f $TRASSA_STOP ] && break
		# Демон проработал больше минуты — это не череда падений, пауза возвращается к начальной.
		[ $(($(date +%s) - trassa_t0)) -ge 60 ] && trassa_pause=5
		echo "$(date '+%Y/%m/%d %H:%M:%S') демон завершился с кодом $trassa_code, перезапуск через $trassa_pause с" >>$TRASSA_LOG
		sleep $trassa_pause
		[ $trassa_pause -lt 60 ] && trassa_pause=$((trassa_pause * 2))
	done
}

# Сторож: демон жив, но не отвечает — завершить принудительно. Заодно не даёт журналу расти без предела.
trassa_watch() {
	trap "" HUP PIPE
	trassa_fails=0
	while [ ! -f $TRASSA_STOP ]; do
		sleep 5
		if $TRASSA_BIN status >/dev/null 2>&1; then
			trassa_fails=0
		else
			trassa_fails=$((trassa_fails + 1))
		fi
		if [ $trassa_fails -ge 2 ]; then
			trassa_p=$(trassa_pid) && {
				echo "$(date '+%Y/%m/%d %H:%M:%S') демон не отвечает, принудительное завершение" >>$TRASSA_LOG
				kill -9 "$trassa_p" 2>/dev/null
			}
			trassa_fails=0
		fi
		if [ "$(wc -c <$TRASSA_LOG 2>/dev/null || echo 0)" -gt $TRASSA_LOG_MAX ]; then
			# Пишущие открывают журнал на дозапись, поэтому его можно укоротить на месте.
			tail -c $TRASSA_LOG_KEEP $TRASSA_LOG >$TRASSA_LOG.keep 2>/dev/null &&
				cat $TRASSA_LOG.keep >$TRASSA_LOG
			rm -f $TRASSA_LOG.keep
			echo "$(date '+%Y/%m/%d %H:%M:%S') журнал укорочен" >>$TRASSA_LOG
		fi
	done
}

# Присмотр за веб-страницей: если она завершилась, запустить снова. Страница не трогает сеть,
# поэтому снимать после неё нечего.
trassa_supervise_web() {
	trap "" HUP PIPE
	PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
	export PATH
	trassa_pause=5
	while [ ! -f $TRASSA_STOP ]; do
		trassa_args=$(cat $TRASSA_CONF/web.args 2>/dev/null)
		trassa_t0=$(date +%s)
		set -f
		$TRASSA_BIN web -dir $TRASSA_CONF $trassa_args >>$TRASSA_LOG 2>&1 &
		set +f
		echo $! >$TRASSA_WEB_PID
		wait $!
		trassa_code=$?
		rm -f $TRASSA_WEB_PID
		[ -f $TRASSA_STOP ] && break
		[ $(($(date +%s) - trassa_t0)) -ge 60 ] && trassa_pause=5
		echo "$(date '+%Y/%m/%d %H:%M:%S') веб-страница завершилась с кодом $trassa_code, перезапуск через $trassa_pause с" >>$TRASSA_LOG
		sleep $trassa_pause
		[ $trassa_pause -lt 60 ] && trassa_pause=$((trassa_pause * 2))
	done
}

trassa_start() {
	if [ ! -x $TRASSA_BIN ]; then
		echo "нет $TRASSA_BIN"
		return 1
	fi
	trassa_daemon_up=0
	if $TRASSA_BIN status >/dev/null 2>&1 || [ -n "$(trassa_all run)" ]; then
		trassa_daemon_up=1
	fi
	trassa_web_up=0
	[ -n "$(trassa_all web)" ] && trassa_web_up=1
	# Не запущено ничего — список присмотров начинается заново: номера прежних процессов
	# могли достаться посторонним.
	if [ $trassa_daemon_up = 0 ] && [ $trassa_web_up = 0 ]; then
		: >$TRASSA_SUP
	fi
	rm -f $TRASSA_STOP
	trassa_rc=0
	# Демон и страница запускаются по отдельности: страница нужна и тогда, когда в правилах
	# ошибка, — чтобы их исправить.
	if [ $trassa_daemon_up = 1 ]; then
		echo "демон trassa уже запущен"
	elif ! $TRASSA_BIN check $TRASSA_CONF/rules.conf >/dev/null; then
		echo "в правилах ошибки, демон trassa не запущен: $TRASSA_BIN check $TRASSA_CONF/rules.conf"
		trassa_rc=1
	else
		rm -f $TRASSA_PID
		# Потоки присмотра и сторожа отвязываются от сеанса, из которого их запустили. Иначе оболочка,
		# сообщая о завершённом по сигналу демоне, пишет в закрытый сеанс и гибнет сама — и демон
		# остаётся без присмотра.
		trassa_supervise >>$TRASSA_LOG 2>&1 </dev/null &
		echo $! >>$TRASSA_SUP
		trassa_watch >>$TRASSA_LOG 2>&1 </dev/null &
		echo $! >>$TRASSA_SUP
		echo "демон trassa запущен"
	fi
	# Страница — только если задан её адрес.
	if [ -f $TRASSA_CONF/web.args ]; then
		if [ $trassa_web_up = 1 ]; then
			echo "веб-страница уже запущена"
		else
			trassa_supervise_web >>$TRASSA_LOG 2>&1 </dev/null &
			echo $! >>$TRASSA_SUP
			echo "веб-страница запущена ($(cat $TRASSA_CONF/web.args))"
		fi
	fi
	return $trassa_rc
}

trassa_stop() {
	touch $TRASSA_STOP
	if [ -f $TRASSA_SUP ]; then
		for trassa_p in $(cat $TRASSA_SUP); do
			kill "$trassa_p" 2>/dev/null
		done
	fi
	# Демон останавливается по сигналу; ждём, пока не исчезнут все его процессы.
	for trassa_p in $(trassa_all run) $(trassa_all web); do
		kill "$trassa_p" 2>/dev/null
	done
	trassa_i=0
	while [ -n "$(trassa_all run)$(trassa_all web)" ] && [ $trassa_i -lt 10 ]; do
		sleep 1
		trassa_i=$((trassa_i + 1))
	done
	for trassa_p in $(trassa_all run) $(trassa_all web); do
		kill -9 "$trassa_p" 2>/dev/null
	done
	$TRASSA_BIN cleanup >/dev/null 2>&1
	rm -f $TRASSA_SUP $TRASSA_PID $TRASSA_WEB_PID
	echo "trassa остановлен"
}

case "$1" in
start)
	trassa_start
	;;
stop)
	trassa_stop
	;;
restart)
	trassa_stop
	trassa_start
	;;
status)
	$TRASSA_BIN status
	trassa_w=$(trassa_all web | head -1)
	if [ -n "$trassa_w" ]; then
		echo "веб-страница: работает ($(cat $TRASSA_CONF/web.args 2>/dev/null))"
	else
		echo "веб-страница: не запущена"
	fi
	;;
*)
	echo "Использование: $0 {start|stop|restart|status}"
	;;
esac
